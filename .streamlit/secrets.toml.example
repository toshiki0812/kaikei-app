# このファイルをコピーして `secrets.toml` という名前で保存し、中身を自分のものに書き換えます。
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# secrets.toml は .gitignore に入れてあるのでGitHubには上がりません。
# クラウド（Streamlit Cloud）側では、この中身を管理画面の Secrets 欄に貼り付けます。

# データベースの接続文字列（Supabase / Neon などの管理画面からコピーします）
# 例: postgresql://postgres:パスワード@db.xxxxx.supabase.co:5432/postgres
database_url = "ここに接続文字列を貼り付け"

# アプリを開くときの合言葉。夫婦二人で共有します。
# 推測されにくい長めのものにしてください。
app_password = "ここに合言葉を入力"
